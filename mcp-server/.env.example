# Sao chép file này thành .env và điền thông tin thực

# URL gốc của website WordPress (không có dấu / ở cuối)
XCLIPSE_URL=https://xclipse.com

# API Key — lấy từ WordPress Admin > Cài đặt > MCP API Key
XCLIPSE_API_KEY=your-api-key-here

# Tối ưu token: 'compact' (khuyên dùng cho Gemini Spark / AI — chỉ lộ ~28 tool chính + xclipse_discover/xclipse_call, giảm 90% token) hoặc 'full' (391 tools)
XCLIPSE_TOOL_MODE=compact

# Bật nén JSON phản hồi (bỏ null, "", []) để tiết kiệm token (1 = bật, 0 = tắt)
XCLIPSE_COMPACT=1

# ── Cấu hình Remote MCP Server URL (deploy cloud / Gemini Spark) ──
# Đặt PORT hoặc MCP_TRANSPORT=http để chạy dạng HTTP URL thay vì stdio
# PORT=3000
# MCP_AUTH_TOKEN=your-secret-bearer-token
